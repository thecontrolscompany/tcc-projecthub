        "RH5-C",
        "RH6-C",
        "RH7-C",
        "RH8-C"
      ],
      "ancestor_selectors": [
        ".bas-floor-graphics-display-point"
      ],
      "hide_descendants": true,
      "notes": "The current mixed-air estimator trial is modulating-only; hide staged command labels and their value/alias text while leaving PH-O, CLG-O, RH-O, PH-POS, CLG-POS, and RH-POS visible."
    }
