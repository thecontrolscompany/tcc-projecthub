{
  "generated_at": "2026-06-06T00:00:00.000Z",
  "rules": [
    {
      "rule_id": "hide_imported_dashboard_modules",
      "description": "Hide imported dashboard, parameter, and key-data modules by default in estimator previews.",
      "mode": "hide",
      "selectors": [
        "[svgkdi='kdi']",
        "[kdi='kdi']",
        ".kdm",
        ".KDMExpanded",
        ".KDMCollapsed",
        ".KDIPlaceholder",
        ".KDIColPlaceholder",
        ".KDMplaceholdersvg",
        ".KDMColplaceholdersvg",
        "#KDMExpanded",
        "#KDMCollapsed",
        "#KDIPlaceholder",
        "#KDIColPlaceholder",
        "#ButtonToCollapse",
        "#ButtonToExpand",
        "[class*='KDMExpWidthRect']",
        "[class*='KDMExpHeightRect']",
        "[class*='kdmheader']",
        "[class*='scrollbar']",
        "[data-ng-click*='hideShowKeyDataModule']",
        "[data-filter*='SYSTEM PARAMETERS']",
        "[data-filter*='SYSTEM SETPOINTS']"
      ],
      "text_matches": [
        "SYSTEM PARAMETERS",
        "SYSTEM SETPOINTS"
      ],
      "attribute_matches": [
        { "name": "svgkdi", "contains": "kdi" },
        { "name": "kdi", "contains": "kdi" },
        { "name": "kdmlabel", "contains": "SYSTEM" },
        { "name": "data-ng-click", "contains": "hideShowKeyDataModule" }
      ],
      "ancestor_selectors": [
        "[svgkdi='kdi']",
        "[kdi='kdi']",
        ".kdm",
        "#KDMExpanded",
        "#KDMCollapsed"
      ],
      "hide_descendants": true,
      "notes": "Imported dashboard modules are not estimator graphics and should be hidden unless debugging imported layout behavior."
    },
    {
      "rule_id": "hide_staged_heat_cool_points_for_modulating_config",
      "description": "Hide staged heating and cooling command labels for the mixed-air modulating trial.",
      "mode": "hide",
      "template_ids": [
